# Shortsrator 로컬 환경변수 — 실제 값은 .env 에만 둔다 (.env 는 gitignore됨).
# 쓰는 벤더의 키만 채우면 된다 (docs/03-architecture.md 실행법 참고).

# Higgsfield (이미지/영상 생성) — platform.higgsfield.ai
HF_API_KEY_ID=
